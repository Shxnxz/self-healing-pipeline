# Copy to .env to override the defaults used by docker-compose.yml
NEO4J_PASSWORD=selfhealing

# Optional local Qwen triage (Ollama must be reachable from Docker)
QWEN_ENABLED=false
QWEN_MODEL=qwen3:4b-instruct
QWEN_BASE_URL=http://host.docker.internal:11434

# Optional partition replay (leave unset to read Crash1/Crash2/Crash3)
# TABLES=Crash4
# CSV_FILES=Crash4-2.csv
# KAFKA_TOPICS=crashes.crash4

# Forward versioned incident JSON after saving the local copy.
# Rebuild Spark images after enabling this dependency: docker compose build
QWEN_KAFKA_ENABLED=false
QWEN_INCIDENT_TOPIC=recovery.incidents

# Optional canonical columns may be absent; unknown extra columns are still parked.
SILVER1_OPTIONAL_COLUMNS=[]
# Keep stable while resuming a checkpoint. Change when resetting the checkpoint
# against an existing Delta output, otherwise Delta may skip reused batch IDs.
SILVER1_TXN_APP_ID=silver1

# Recovery agent: Diagnose (reasoning model on Ollama) and the policy gate.
# Pull the model first: ollama pull qwen3:8b. A larger Qwen reasons better.
DIAGNOSE_MODEL=qwen3:8b
DIAGNOSE_BASE_URL=http://host.docker.internal:11434
# false = the model answers directly. Qwen3's thinking counts against the reply
# size and can cut the answer off. Check with: python -m agent.check_model
DIAGNOSE_THINK=false
# A diagnosis runs without an engineer only at or above this confidence (0.5 to 1)...
POLICY_CONFIDENCE_THRESHOLD=0.85
# ...or this stricter one when nothing in the records can confirm the proposed
# value (every column except crash_month and crash_day_of_week). NEVER = those
# always go to an engineer.
POLICY_UNVERIFIED_CONFIDENCE_THRESHOLD=0.95
# ...and only for an action in the safe set (agent/actions.py). Leave empty for
# that set; NONE sends every diagnosis to an engineer.
POLICY_SAFE_ACTIONS=
# Validate replays staged records in a small Spark session inside the agent.
VALIDATE_SPARK_DRIVER_MEMORY=512m
